<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 红线 R2：权限最小集。任何新增权限须在 spec/redlines.md 评审记录 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台引导模式悬浮叙述面板（S3）：TYPE_APPLICATION_OVERLAY 需要 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ 包可见性：launch_app 原语需要能看到可启动的测试 App（架构 §4.1 原语 7） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P0：BYOK 设置页（Keystore 存取，product_milestones.md P0 DoD3） -->
        <activity android:name=".SettingsActivity" android:exported="false" />

        <!-- 八原语调试面板（原 MainActivity 调试形态，研究/排障用） -->
        <activity android:name=".DebugPanelActivity" android:exported="false" />

        <!-- Canvas 盲区测试页（P1 DoD3 fixture）：自绘目标零语义，仅组件显式可达 -->
        <activity android:name=".CanvasProbeActivity" android:exported="true"
            android:label="CanvasProbe" />

        <!-- 授权门控弹层（S3 GateUI）：由无障碍服务在敏感操作前拉起 -->
        <activity
            android:name=".gate.GateActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Dialog"
            android:excludeFromRecents="true" />

        <service
            android:name=".HachimiAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".KernelHostService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 调试桥：仅 debuggable 构建生效（代码内门控），release 哑接收器 -->
        <receiver
            android:name=".DebugBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hachimi.app.DEBUG_PRIMITIVE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
